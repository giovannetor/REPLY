# Copy to .env (gitignored). Credentials are read by Bun on the server only.
# Never prefix a credential with VITE_: those values enter the browser bundle.
GEMINI_API_KEY=
AI_EVALUATION_MODEL=gemini-3.5-flash-lite
AI_EVALUATION_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
AI_EVALUATION_TIMEOUT_MS=20000
AI_EVALUATION_ALLOWED_ORIGIN=http://localhost:5173
PORT=8787

# Optional: use this when frontend and backend are hosted separately.
# Vite dev/preview proxy /api/evaluate to localhost:8787 by default.
# VITE_EVALUATION_API_URL=http://localhost:8787/evaluate
